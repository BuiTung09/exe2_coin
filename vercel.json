{
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "outputDirectory": "build"
    },
    "server": {
      "root": "server",
      "framework": "nestjs",
      "entrypoint": "src/main.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}